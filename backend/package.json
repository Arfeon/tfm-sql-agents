{
  "name": "graphsql-backend",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "gsql": "bin/gsql.js"
  },
  "scripts": {
    "start": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:diagnostic": "vitest run tests/diagnostic",
    "test:integration": "vitest run tests/integration",
    "evaluate": "tsx src/evaluation/runEvaluation.ts",
    "evaluate:descriptions": "tsx src/evaluation/runDescriptionsAblation.ts",
    "evaluate:scale": "tsx src/evaluation/runScaleEval.ts",
    "evaluate:aggregate": "tsx src/evaluation/aggregateScaleRuns.ts",
    "evaluate:confusion": "tsx src/evaluation/runConfusionEval.ts",
    "evaluate:review": "tsx src/evaluation/reviewCases.ts",
    "seed": "tsx src/datasets/seedArcadia.ts",
    "seed:nebula": "tsx src/datasets/seedNebula.ts",
    "prepare": "cd .. && husky backend/.husky"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.6",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@langchain/openai": "^1.5.3",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "cli-table3": "^0.6.5",
    "dotenv": "^16.6.1",
    "figlet": "^1.11.0",
    "gradient-string": "^3.0.0",
    "mssql": "^12.7.0",
    "neo4j-driver": "^6.1.0",
    "ora": "^9.4.1",
    "pg": "^8.22.0",
    "pg-cursor": "^2.21.0",
    "tsx": "^4.19.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@types/figlet": "^1.7.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/pg-cursor": "^2.7.2",
    "@types/seedrandom": "^2.4.34",
    "husky": "^9.1.7",
    "seedrandom": "^3.0.5",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
