# ===========================================
# Configuración de GraphSQL
# ===========================================
# Este fichero ya viene listo para arrancar con las bases de DEMO (arcadia y nebula):
# haz `cp .env.example .env` y funciona TAL CUAL. Lo ÚNICO que TIENES que tocar:
#
#   → OPENAI_API_KEY  (pega tu clave)         ... o bien
#   → LLM_PROVIDER=local + EMBEDDING_PROVIDER=local  (para ir 100% offline con LM Studio)
#
# Las contraseñas ya traen un valor por defecto que funciona en local; no hace falta
# cambiarlas para la demo (los contenedores son locales y desechables). Si aun así las
# cambias, cámbialas en TODAS las líneas de contraseña de este fichero (Postgres, Neo4j
# y las TARGET_DB_*_PASSWORD apuntan al mismo servidor local).

# Proveedor del modelo de chat
LLM_PROVIDER=openai
# Opciones: openai (nube) | local (LM Studio) | gateway (servidor LLM corporativo)
#          los tres hablan la API de OpenAI; solo cambian la URL, la clave y el modelo.
# Opcional: déjalo vacío para usar la temperatura por defecto del modelo (algunos rechazan otros valores)
LLM_TEMPERATURE=

# Uso DOS modelos por proveedor según la tarea (con caída al modelo base si no los pones,
# así "pueden ser el mismo"):
#   *_MODEL_REASONING  → razonar QUÉ tablas hacen falta (el schema selector)
#   *_MODEL_GENERATION → escribir/evaluar la SQL (generador + juez + equivalencia)
#   *_MODEL            → modelo base y fallback de ambos roles

# Configuración de OpenAI (necesitas una API key; tiene coste por uso)
# ↓↓↓ PEGA AQUÍ TU CLAVE (o cambia LLM_PROVIDER=local más arriba para no usar OpenAI) ↓↓↓
OPENAI_API_KEY=sk-tu-api-key-aqui
# Con el que está medida la evaluación del proyecto:
OPENAI_MODEL=gpt-5-mini
# Opcionales: un modelo distinto por rol (si los omites, ambos usan OPENAI_MODEL).
# OPENAI_MODEL_REASONING=gpt-5
# OPENAI_MODEL_GENERATION=gpt-5-mini

# LLM local (LM Studio) — expone una API compatible con OpenAI; sin coste ni API key.
# Modelo base recomendado para local: especialista en SQL (escribe la SELECT).
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen2.5-coder-14b-instruct
LMSTUDIO_API_KEY=lm-studio
# Opcional: un modelo de razonamiento aparte para elegir tablas (p. ej. el 9b de antes).
# Si lo omites, el selector usa LMSTUDIO_MODEL.
# LMSTUDIO_MODEL_REASONING=qwen3.5-9b-instruct
# LMSTUDIO_MODEL_GENERATION=qwen2.5-coder-14b-instruct

# Gateway LLM corporativo (LiteLLM y compatibles) — un servidor propio que habla la API de
# OpenAI y decide él qué modelo hay detrás (uno alojado por nosotros, o OpenAI con la clave
# de la empresa). El nombre del modelo es el ALIAS que publica el gateway, no el del modelo
# de debajo: míralos con `curl -H "Authorization: Bearer <clave>" <URL>/models`.
GATEWAY_BASE_URL=http://localhost:4000/v1
GATEWAY_API_KEY=
GATEWAY_MODEL=
# Opcionales: un alias distinto por rol (si los omites, ambos usan GATEWAY_MODEL).
# GATEWAY_MODEL_REASONING=
# GATEWAY_MODEL_GENERATION=
# Embeddings por el mismo gateway (si también sirve /embeddings):
GATEWAY_EMBEDDING_MODEL=text-embedding-3-small
GATEWAY_EMBEDDING_DIMENSIONS=1536
# Pedir una dimensión concreta solo funciona con la familia text-embedding-3. Si detrás del
# gateway hay un modelo propio (bge-m3 y compañía), déjalo en false y pon arriba su dimensión nativa.
GATEWAY_EMBEDDING_SEND_DIMENSIONS=false

# Embeddings (vectorización del esquema). El proveedor se elige en el CLI al escanear.
# IMPORTANTE: hay que indexar y consultar con el MISMO modelo. Cambiarlo obliga a re-vectorizar.
# Proveedor por defecto para usos no interactivos / tests:
EMBEDDING_PROVIDER=openai
# Opciones: openai | local | gateway (independiente de LLM_PROVIDER: puedes chatear por un sitio y vectorizar por otro)
# Configuración por proveedor (modelo + dimensión):
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# Local (LM Studio): bge-m3=1024, multilingual-e5-large=1024
LMSTUDIO_EMBEDDING_MODEL=text-embedding-bge-m3
LMSTUDIO_EMBEDDING_DIMENSIONS=1024

# ===========================================
# Contraseña local de las bases de datos
# ===========================================
# Un único valor para todo lo local. docker-compose CREA Postgres y Neo4j con estas
# contraseñas, y el backend se conecta con las mismas (leen este mismo fichero), así que
# siempre cuadran. Cámbialas si quieres, pero entonces hazlo en las cuatro líneas de
# PASSWORD de este fichero. Para la demo no hace falta tocar nada.

# ===========================================
# Configuración de Neo4j (grafo de conocimiento)
# ===========================================
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphsql_local
NEO4J_DATABASE=neo4j

# ===========================================
# PostgreSQL + pgvector (memoria y embeddings)
# ===========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=graphsql_memory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=graphsql_local

# NOTA: docker-compose lee `NEO4J_USER`/`NEO4J_PASSWORD` y `POSTGRES_*` de este mismo
# fichero para crear los contenedores. No subas tu `.env` con secretos reales al repo.

# ===========================================
# Bases de datos objetivo (las que consultas en lenguaje natural)
# ===========================================
# Catálogo numerado: TARGET_DB_1_*, TARGET_DB_2_*, ... El CLI las muestra para elegir.
# Ya vienen las tres de demo, que docker-compose crea automáticamente:
#   arcadia (17 tablas, uso diario)  ·  nebula (66 tablas, prueba de escala)
#   meridian (41 tablas, ERP de otro dominio para validar la generalización)
# Apuntan al Postgres local, así que su contraseña es la misma de POSTGRES_PASSWORD.

TARGET_DB_1_TYPE=postgresql
TARGET_DB_1_HOST=localhost
TARGET_DB_1_PORT=5432
TARGET_DB_1_NAME=arcadia
TARGET_DB_1_SCHEMA=public
TARGET_DB_1_USER=postgres
TARGET_DB_1_PASSWORD=graphsql_local

# nebula: BD grande sintética de la prueba de escala (SPEC-17). PUBLIC=false porque es
# sintética (una BD pública haría que la evaluación avisara de contaminación del LLM).
TARGET_DB_2_TYPE=postgresql
TARGET_DB_2_HOST=localhost
TARGET_DB_2_PORT=5432
TARGET_DB_2_NAME=nebula
TARGET_DB_2_SCHEMA=public
TARGET_DB_2_USER=postgres
TARGET_DB_2_PASSWORD=graphsql_local
TARGET_DB_2_PUBLIC=false

# meridian: ERP de distribución mayorista (~41 tablas), un DOMINIO distinto al de
# arcadia/nebula (videojuegos), para medir si el schema-linking generaliza. Sintética,
# así que PUBLIC=false. También la crea docker-compose en el Postgres local.
TARGET_DB_3_TYPE=postgresql
TARGET_DB_3_HOST=localhost
TARGET_DB_3_PORT=5432
TARGET_DB_3_NAME=meridian
TARGET_DB_3_SCHEMA=public
TARGET_DB_3_USER=postgres
TARGET_DB_3_PASSWORD=graphsql_local
TARGET_DB_3_PUBLIC=false

# ── Tu propia base de datos ────────────────────────────────────────────────────
# Cuando quieras consultar la TUYA, añádela como TARGET_DB_4_* (aparecerá en el CLI).
# Ejemplo con SQL Server (puerto/schema por defecto si los omites: 1433/dbo). Conexión
# cifrada en tránsito sin validar certificado de CA (encrypt + trustServerCertificate),
# pensado para instancias on-premise sin certificado propio.
# TARGET_DB_4_TYPE=mssql
# TARGET_DB_4_HOST=localhost
# TARGET_DB_4_PORT=1433
# TARGET_DB_4_NAME=tu_base_de_datos
# TARGET_DB_4_SCHEMA=dbo
# TARGET_DB_4_USER=sa
# TARGET_DB_4_PASSWORD=tu-password-de-bd

# Qué BD evalúa `npm run evaluate` (por nombre). Vacío = la primera del catálogo (arcadia).
# EVAL_TARGET=nebula

# ===========================================
# Configuración del agente
# ===========================================
MAX_ITERATIONS=3
REQUIRE_HUMAN_APPROVAL=true
SIMILARITY_THRESHOLD=0.75
MAX_FEEDBACK_EXAMPLES=5

# ===========================================
# Logs
# ===========================================
LOG_LEVEL=INFO
DEBUG=false

# ===========================================
# Observabilidad (LangSmith) — OPCIONAL, apagada por defecto
# ===========================================
# Trazado de la suite de LangChain (capa gratuita): cada ejecución del grafo queda
# como un árbol con las entradas/salidas de cada nodo y cada llamada LLM. Útil para
# depurar en desarrollo; NO hace falta para usar GraphSQL. Es un servicio en la nube:
# actívalo solo con datos de prueba (con esquemas reales contradice el on-premise, D-14).
# Alternativa auto-alojable dentro del perímetro: Langfuse (open source).
LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_API_KEY=tu-api-key
# LANGSMITH_PROJECT=graphsql
