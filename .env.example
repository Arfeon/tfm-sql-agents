# ===========================================
# Configuración de GraphSQL
# ===========================================

# Proveedor del modelo de chat
LLM_PROVIDER=openai
# Opciones: openai (nube) | local (LM Studio, API compatible con OpenAI)
# Opcional: déjalo vacío para usar la temperatura por defecto del modelo (algunos rechazan otros valores)
LLM_TEMPERATURE=

# Uso DOS modelos por proveedor según la tarea (con caída al modelo base si no los pones,
# así "pueden ser el mismo"):
#   *_MODEL_REASONING  → razonar QUÉ tablas hacen falta (el schema selector)
#   *_MODEL_GENERATION → escribir/evaluar la SQL (generador + juez + equivalencia)
#   *_MODEL            → modelo base y fallback de ambos roles

# Configuración de OpenAI (necesitas una API key; tiene coste por uso)
OPENAI_API_KEY=sk-tu-api-key-aqui
# Con el que está medida la evaluación del proyecto:
OPENAI_MODEL=gpt-5-mini
# Opcionales: un modelo distinto por rol (si los omites, ambos usan OPENAI_MODEL).
# OPENAI_MODEL_REASONING=gpt-5
# OPENAI_MODEL_GENERATION=gpt-5-mini

# LLM local (LM Studio) — expone una API compatible con OpenAI; sin coste ni API key.
# Modelo base recomendado para local: especialista en SQL (escribe la SELECT).
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen2.5-coder-14b-instruct
LMSTUDIO_API_KEY=lm-studio
# Opcional: un modelo de razonamiento aparte para elegir tablas (p. ej. el 9b de antes).
# Si lo omites, el selector usa LMSTUDIO_MODEL.
# LMSTUDIO_MODEL_REASONING=qwen3.5-9b-instruct
# LMSTUDIO_MODEL_GENERATION=qwen2.5-coder-14b-instruct

# Embeddings (vectorización del esquema). El proveedor se elige en el CLI al escanear.
# IMPORTANTE: hay que indexar y consultar con el MISMO modelo. Cambiarlo obliga a re-vectorizar.
# Proveedor por defecto para usos no interactivos / tests:
EMBEDDING_PROVIDER=openai
# Configuración por proveedor (modelo + dimensión):
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# Local (LM Studio): bge-m3=1024, multilingual-e5-large=1024
LMSTUDIO_EMBEDDING_MODEL=text-embedding-bge-m3
LMSTUDIO_EMBEDDING_DIMENSIONS=1024

# ===========================================
# Configuración de Neo4j (grafo de conocimiento)
# ===========================================
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tu-password-de-neo4j
NEO4J_DATABASE=neo4j

# ===========================================
# PostgreSQL + pgvector (memoria y embeddings)
# ===========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=graphsql_memory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu-password-de-postgres

# NOTA: docker-compose lee `NEO4J_USER` y `NEO4J_PASSWORD` para formar
# `NEO4J_AUTH` (usuario/contraseña). Copia los valores a un `.env` local
# para desarrollo y no subas secretos al control de versiones.

# ===========================================
# Base de datos objetivo
# (la que quieres consultar en lenguaje natural)
# ===========================================
# Catálogo de BDs objetivo, numeradas: TARGET_DB_1_*, TARGET_DB_2_*, ...
# El CLI las muestra para elegir cuál escanear. TYPE soportado: postgresql | mssql (SQL Server).
TARGET_DB_1_TYPE=postgresql
TARGET_DB_1_HOST=localhost
TARGET_DB_1_PORT=5432
TARGET_DB_1_NAME=tu_base_de_datos
TARGET_DB_1_SCHEMA=public
TARGET_DB_1_USER=postgres
TARGET_DB_1_PASSWORD=tu-password-de-bd

# Añade más BDs incrementando el índice. Ejemplo: nebula, la BD grande sintética de la
# prueba de escala (SPEC-17). PUBLIC=true marca una BD pública (la evaluación avisa de
# posible contaminación del LLM); nebula es sintética, así que false.
# TARGET_DB_2_TYPE=postgresql
# TARGET_DB_2_HOST=localhost
# TARGET_DB_2_PORT=5432
# TARGET_DB_2_NAME=nebula
# TARGET_DB_2_SCHEMA=public
# TARGET_DB_2_USER=postgres
# TARGET_DB_2_PASSWORD=...
# TARGET_DB_2_PUBLIC=false

# Ejemplo con SQL Server (puerto/schema por defecto si los omites: 1433/dbo). Conexión
# cifrada en tránsito sin validar certificado de CA (encrypt + trustServerCertificate),
# pensado para instancias on-premise sin certificado propio.
# TARGET_DB_3_TYPE=mssql
# TARGET_DB_3_HOST=localhost
# TARGET_DB_3_PORT=1433
# TARGET_DB_3_NAME=tu_base_de_datos
# TARGET_DB_3_SCHEMA=dbo
# TARGET_DB_3_USER=sa
# TARGET_DB_3_PASSWORD=tu-password-de-bd

# Qué BD evalúa `npm run evaluate` (por nombre). Vacío = la primera del catálogo (Arcadia).
# EVAL_TARGET=nebula

# ===========================================
# Configuración del agente
# ===========================================
MAX_ITERATIONS=3
REQUIRE_HUMAN_APPROVAL=true
SIMILARITY_THRESHOLD=0.75
MAX_FEEDBACK_EXAMPLES=5

# ===========================================
# Logs
# ===========================================
LOG_LEVEL=INFO
DEBUG=false

# ===========================================
# Observabilidad (LangSmith) — OPCIONAL, apagada por defecto
# ===========================================
# Trazado de la suite de LangChain (capa gratuita): cada ejecución del grafo queda
# como un árbol con las entradas/salidas de cada nodo y cada llamada LLM. Útil para
# depurar en desarrollo; NO hace falta para usar GraphSQL. Es un servicio en la nube:
# actívalo solo con datos de prueba (con esquemas reales contradice el on-premise, D-14).
# Alternativa auto-alojable dentro del perímetro: Langfuse (open source).
LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_API_KEY=tu-api-key
# LANGSMITH_PROJECT=graphsql
